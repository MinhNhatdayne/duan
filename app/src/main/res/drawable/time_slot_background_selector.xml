<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- TRẠNG THÁI ĐƯỢC CHỌN (SELECTED) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E1BEE7"/> <!-- Màu nền Tím nhạt -->
            <stroke android:width="2dp" android:color="#7B1FA2"/> <!-- Viền Tím đậm -->
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- TRẠNG THÁI BÌNH THƯỜNG -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Màu nền Trắng -->
            <stroke android:width="1dp" android:color="#BDBDBD"/> <!-- Viền Xám -->
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>