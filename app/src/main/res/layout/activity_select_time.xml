<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- Header -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

        <ImageView
                android:id="@+id/btn_back_screen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />
        <!-- Lưu ý: Bạn cần có ic_arrow_back trong drawable, hoặc dùng @android:drawable/ic_menu_revert -->

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Đặt lịch hẹn"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />
    </LinearLayout>

    <!-- Month Selector -->
    <LinearLayout
            android:id="@+id/month_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_blue"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginBottom="8dp"
            android:elevation="2dp">

        <ImageView
                android:id="@+id/btn_prev_month"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/white"/> <!-- Thêm tint màu xám cho icon -->

        <TextView
                android:id="@+id/tv_month_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:text="Tháng Năm 2024"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        <ImageView
                android:id="@+id/btn_next_month"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/white"/>
    </LinearLayout>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn ngày"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDateSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="8dp" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn giờ"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

    <!-- Time Slots -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTimeSlots"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

    <!-- Button Continue -->
    <Button
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2196F3"
            android:enabled="false"
            android:paddingVertical="14dp"
            android:text="Tiếp tục"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

</LinearLayout>