<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        tools:context=".activities_staff.NewAppointmentActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Tạo Cuộc Hẹn Mới"
            app:titleTextColor="@android:color/white" />

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Card 1: Thông tin bệnh nhân -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="1. Thông tin Bệnh nhân"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <EditText
                            android:id="@+id/et_patient_info"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"

                            android:background="@drawable/bg_search_white"
                            android:clickable="true"
                            android:focusable="false"

                            android:hint="Nhập tên hoặc SĐT..."
                            android:inputType="text"
                            android:textSize="14sp"

                            android:paddingHorizontal="12dp"
                            android:drawableStart="@android:drawable/ic_menu_search"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/primary_blue"

                            android:textColor="@android:color/black"
                            android:textColorHint="#757575" />
                    <!-- textColor: Màu chữ khi đã chọn/nhập -->
                    <!-- textColorHint: Màu chữ mờ "Nhập tên..." (Xám đậm hơn mặc định) -->

                    <!-- Kết quả chọn bệnh nhân -->
                    <LinearLayout
                            android:id="@+id/layout_selected_patient"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/tv_selected_patient"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="#E8F5E9"
                                android:padding="12dp"
                                android:textColor="#2E7D32"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="Nguyễn Thị Lan (090xxxxxxx)"
                                tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Dịch vụ -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="2. Dịch vụ &amp; Ghi chú"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <Spinner
                            android:id="@+id/spinner_service"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_spinner_custom"
                            android:paddingStart="12dp"
                            android:paddingEnd="40dp"
                            android:theme="@style/ThemeOverlay.AppCompat.Light"
                            android:popupBackground="@android:color/white" />

                    <EditText
                            android:id="@+id/et_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"

                            android:background="@drawable/bg_search_white"
                            android:gravity="top"

                            android:hint="Ghi chú thêm (Triệu chứng, yêu cầu...)"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textSize="14sp"
                            android:padding="12dp"

                            android:textColor="@android:color/black"
                            android:textColorHint="#757575" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Thời gian & Bác sĩ (ĐÃ CẢI THIỆN) -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="3. Chọn Bác sĩ &amp; Thời gian"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <!-- Nút chọn Bác sĩ: Thiết kế dạng Input Field -->
                    <Button
                            android:id="@+id/btn_select_doctor"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="#F0F4FF"
                            android:drawableStart="@android:drawable/ic_menu_myplaces"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/primary_blue"
                            android:drawableEnd="@android:drawable/arrow_down_float"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="Chọn Bác sĩ phụ trách"
                            android:textAllCaps="false"
                            android:textColor="@color/primary_blue"
                            android:textSize="15sp"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                    <!-- Nút chọn Thời gian: Thiết kế dạng Input Field -->
                    <Button
                            android:id="@+id/btn_select_time"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:backgroundTint="#F0F4FF"
                            android:drawableStart="@android:drawable/ic_menu_today"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/primary_blue"
                            android:drawableEnd="@android:drawable/arrow_down_float"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="Chọn Ngày và Giờ hẹn"
                            android:textAllCaps="false"
                            android:textColor="@color/primary_blue"
                            android:textSize="15sp"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                    <!-- Kết quả chọn: Hiển thị dạng Vé/Ticket -->
                    <LinearLayout
                            android:id="@+id/layout_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/tv_selected_doctor_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:background="@drawable/bg_search_white"
                                android:backgroundTint="#F9FAFB"
                                android:padding="16dp"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp"
                                android:visibility="gone"
                                tools:text="👨‍⚕️ Bác sĩ: Đoàn Hồng Lê\n📅 Thời gian: 14:00 - 14/10/2024"
                                tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút Xác nhận -->
            <Button
                    android:id="@+id/btn_confirm_appointment"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/primary_blue"
                    android:text="XÁC NHẬN TẠO CUỘC HẸN"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>