<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Tạo Cuộc Hẹn Mới"
            app:titleTextColor="@android:color/white" />

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- 1. THÔNG TIN BỆNH NHÂN (NHẬP TAY) -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="1. Thông tin Bệnh nhân"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <!-- Input Tên Bệnh Nhân -->
                    <EditText
                            android:id="@+id/et_patient_name"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_search_white"
                            android:hint="Họ và tên bệnh nhân"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="12dp"
                            android:textColor="@android:color/black"
                            android:textColorHint="#757575"
                            android:textSize="14sp" />

                    <!-- Input Số Điện Thoại -->
                    <EditText
                            android:id="@+id/et_patient_phone"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_search_white"
                            android:hint="Số điện thoại liên hệ"
                            android:inputType="phone"
                            android:paddingHorizontal="12dp"
                            android:textColor="@android:color/black"
                            android:textColorHint="#757575"
                            android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. DỊCH VỤ & BÁC SĨ (DROPDOWN) -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="2. Thông tin khám"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Chọn Dịch vụ:"
                            android:textColor="#555555"
                            android:textSize="13sp" />

                    <Spinner
                            android:id="@+id/spinner_service"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_spinner_custom"
                            android:paddingStart="8dp"
                            android:paddingEnd="30dp"
                            android:theme="@style/ThemeOverlay.AppCompat.Light" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Chọn Bác sĩ phụ trách:"
                            android:textColor="#555555"
                            android:textSize="13sp" />

                    <Spinner
                            android:id="@+id/spinner_doctor"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_spinner_custom"
                            android:paddingStart="8dp"
                            android:paddingEnd="30dp"
                            android:theme="@style/ThemeOverlay.AppCompat.Light" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. THỜI GIAN & GHI CHÚ -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="3. Thời gian &amp; Ghi chú"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <!-- Input Ngày Giờ (Click mở Dialog) -->
                    <EditText
                            android:id="@+id/et_date_time"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_search_white"
                            android:clickable="true"
                            android:drawableStart="@android:drawable/ic_menu_my_calendar"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/primary_blue"
                            android:focusable="false"
                            android:hint="Chọn Ngày &amp; Giờ hẹn..."
                            android:inputType="none"
                            android:paddingHorizontal="12dp"
                            android:textColor="@android:color/black"
                            android:textColorHint="#757575"
                            android:textSize="14sp" />

                    <EditText
                            android:id="@+id/et_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_search_white"
                            android:gravity="top"
                            android:hint="Ghi chú thêm (Triệu chứng...)"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:padding="12dp"
                            android:textColor="@android:color/black"
                            android:textColorHint="#757575"
                            android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                    android:id="@+id/btn_confirm_appointment"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/primary_blue"
                    android:text="XÁC NHẬN TẠO CUỘC HẸN"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>