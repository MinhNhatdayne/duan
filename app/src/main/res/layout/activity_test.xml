<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <EditText
            android:id="@+id/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập họ tên bệnh nhân"
            />
        <EditText
            android:id="@+id/ngaysinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="nhập ngày sinh  bệnh nhân"
            />
        <EditText
            android:id="@+id/gioitinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="nhập giới tính"
            />
        <EditText
            android:id="@+id/diachi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="nhập địa chỉ"
            />
        <EditText
            android:id="@+id/sodienthoai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="nhập số điện thoại"
            />
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="nhập email"
            />
        <EditText
            android:id="@+id/pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="nhập password"
            />
        <Button
            android:id="@+id/btnthem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="thêm bệnh nhân"/>
        <Button
            android:id="@+id/btnxoa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="xóa bệnh nhân"
            />
        <Button
            android:id="@+id/btnCapNhat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="cập nhật thông tin bệnh nhân"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dsbenhnhan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</ScrollView>