<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

        <!-- Icon loại thông báo (Ví dụ icon cái chuông hoặc logo) -->
        <LinearLayout
                android:id="@+id/icon_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#F0F4FF"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/primary_blue"/>
        </LinearLayout>

        <!-- Nội dung thông báo -->
        <TextView
                android:id="@+id/tv_notification_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="Nội dung thông báo hiển thị ở đây. Ví dụ: Lịch hẹn của bạn đã được xác nhận thành công."
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                app:layout_constraintEnd_toStartOf="@id/img_status_dot"
                app:layout_constraintStart_toEndOf="@id/icon_container"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- Thời gian -->
        <TextView
                android:id="@+id/tv_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2 giờ trước"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/tv_notification_content"
                app:layout_constraintTop_toBottomOf="@id/tv_notification_content" />

        <!-- Chấm đỏ (Trạng thái chưa đọc) -->
        <ImageView
                android:id="@+id/img_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_notification_dot"
                android:contentDescription="Chưa đọc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_notification_content" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>