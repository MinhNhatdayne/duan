<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        tools:context=".activities_staff.AppointmentManagerActivity">

    <!-- HEADER: Nền xanh -->
    <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_blue"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toTopOf="parent">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quản lý Lịch hẹn"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        <Button
                android:id="@+id/btn_new_appointment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:drawableStart="@android:drawable/ic_input_add"
                android:drawablePadding="4dp"
                android:drawableTint="@color/primary_blue"
                android:minHeight="40dp"
                android:paddingHorizontal="16dp"
                android:text="Tạo mới"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- KHU VỰC BỘ LỌC (FILTER BAR) -->
    <androidx.cardview.widget.CardView
            android:id="@+id/card_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

            <!-- 1. Chọn Ngày -->
            <TextView
                    android:id="@+id/tv_filter_date"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_white"
                    android:drawableStart="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/primary_blue"
                    android:gravity="center_vertical"
                    android:hint="Lọc theo ngày"
                    android:paddingHorizontal="8dp"
                    android:textSize="13sp"
                    android:layout_marginEnd="8dp"/>

            <!-- 2. Tìm Bác sĩ -->
            <EditText
                    android:id="@+id/et_search_doctor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_search_white"
                    android:hint="Tìm tên BS..."
                    android:textSize="13sp"
                    android:paddingHorizontal="8dp"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            <!-- 3. Nút Xóa lọc -->
            <ImageView
                    android:id="@+id/btn_clear_filter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#D32F2F"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- LIST APPOINTMENTS -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_appointments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="80dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation_staff"
            app:layout_constraintTop_toBottomOf="@id/card_filter"
            tools:listitem="@layout/item_appointment_staff" />

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_staff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:elevation="8dp"
            app:itemIconTint="@color/primary_blue"
            app:itemTextColor="@color/primary_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_nav_menu_staff" />

</androidx.constraintlayout.widget.ConstraintLayout>