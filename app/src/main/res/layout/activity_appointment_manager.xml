<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        tools:context=".activities_staff.AppointmentManagerActivity">

    <!-- HEADER: Nền xanh primary_blue -->
    <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_blue"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quản lý Lịch hẹn"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        <!-- Nút Tạo mới: Nền Trắng - Chữ Xanh (để nổi trên nền Header xanh) -->
        <Button
                android:id="@+id/btn_new_appointment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:drawableStart="@android:drawable/ic_input_add"
                android:drawablePadding="4dp"
                android:drawableTint="@color/primary_blue"
                android:minHeight="40dp"
                android:paddingHorizontal="16dp"
                android:text="Tạo mới"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- LIST APPOINTMENTS -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_appointments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="16dp"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation_staff"
            app:layout_constraintTop_toBottomOf="@id/header_layout"
            tools:listitem="@layout/item_appointment_detail" />

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_staff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:elevation="8dp"
            app:itemIconTint="@color/primary_blue"
            app:itemTextColor="@color/primary_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_nav_menu_staff" />

</androidx.constraintlayout.widget.ConstraintLayout>