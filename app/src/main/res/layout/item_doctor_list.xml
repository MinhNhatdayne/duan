<?xml version="1.0" encoding="utf-8"?>
<!-- Tạm thời dùng LinearLayout thay CardView để test lỗi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

    <!-- Avatar Bác Sĩ -->
    <ImageView
            android:id="@+id/img_doctor_avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="#EEEEEE"
            android:contentDescription="Ảnh bác sĩ" />
    <!-- Đã thay background drawable bằng màu xám -->

    <!-- Thông tin + Nút -->
    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

        <!-- Tên Bác Sĩ -->
        <TextView
                android:id="@+id/tv_doctor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Bác Sĩ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="2"
                android:ellipsize="end"/>

        <!-- Chuyên khoa -->
        <TextView
                android:id="@+id/tv_doctor_specialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chuyên khoa"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>

        <!-- Nút Đặt Lịch -->
        <TextView
                android:id="@+id/btn_book_doctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đặt lịch"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#2196F3"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:layout_gravity="start"/>
        <!-- Đã thay background drawable bằng màu xanh cứng -->
    </LinearLayout>

</LinearLayout>