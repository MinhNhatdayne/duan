<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!-- CỘT 1: THỜI GIAN -->
        <LinearLayout
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="#F0F4FF"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="16dp">

            <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:30"
                    android:textColor="@color/primary_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E0E0E0" />

        <!-- CỘT 2: THÔNG TIN CHI TIẾT -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

            <!-- Tên Bệnh nhân & Trạng thái -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/tv_patient_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Nguyễn Văn A"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                        android:id="@+id/card_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#E8F5E9"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp">

                    <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Đã đến"
                            android:textColor="#2E7D32"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- [MỚI] HÀNG: SỐ ĐIỆN THOẠI -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@android:drawable/ic_menu_call"
                        app:tint="#009688" /> <!-- Màu xanh ngọc -->

                <TextView
                        android:id="@+id/tv_patient_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0987654321"
                        android:textColor="#009688"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
            </LinearLayout>

            <!-- HÀNG 1: DỊCH VỤ -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#1976D2" />

                <TextView
                        android:id="@+id/tv_service_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Dịch vụ: Nhổ răng"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:textSize="13sp" />
            </LinearLayout>

            <!-- HÀNG 2: GHI CHÚ -->
            <LinearLayout
                    android:id="@+id/layout_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#FF9800" />

                <TextView
                        android:id="@+id/tv_appointment_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Note: Bệnh nhân đau nhiều"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textStyle="italic"/>
            </LinearLayout>

            <!-- HÀNG 3: BÁC SĨ -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#757575" />

                <TextView
                        android:id="@+id/tv_doctor_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="BS. Đoàn Hồng Lê"
                        android:textColor="#555555"
                        android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Icon More -->
        <ImageView
                android:id="@+id/btn_more_action"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#BDBDBD" />

    </LinearLayout>
</androidx.cardview.widget.CardView>