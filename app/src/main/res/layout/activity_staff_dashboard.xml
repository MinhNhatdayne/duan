<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        tools:context=".activities_staff.StaffDashboardActivity">

    <!-- HEADER: Nền xanh chủ đạo -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_blue"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/img_notifications"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xin chào, Bác sĩ Việt Anh"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tv_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:text="Quản lý chuyên môn"
                    android:textColor="#E3F2FD"
                    android:textSize="14sp" />
        </LinearLayout>

        <!-- Nút thông báo -->
        <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="#33FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:id="@+id/img_notifications"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Thông báo"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="@android:color/white" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NỘI DUNG CUỘN -->
    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation_staff"
            app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- CARD THỐNG KÊ -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="12dp"
                                android:src="@android:drawable/ic_menu_today"
                                app:tint="@color/primary_blue" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng quan hôm nay"
                                android:textColor="#333333"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                    </LinearLayout>

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="#F0F0F0" />

                    <!-- Thống kê 1: Tổng số -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tổng lượt hẹn:"
                                android:textColor="#666666"
                                android:textSize="15sp" />

                        <TextView
                                android:id="@+id/tv_total_appointments"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textColor="@color/primary_blue"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Thống kê 2: Chờ xử lý -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Đang chờ xác nhận:"
                                android:textColor="#666666"
                                android:textSize="15sp" />

                        <TextView
                                android:id="@+id/tv_pending_appointments"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="#FF9800"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                            android:id="@+id/btn_view_schedule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/primary_blue"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:paddingVertical="12dp"
                            android:text="Xem chi tiết Lịch hẹn"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TITLE CHỨC NĂNG -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Tiện ích bác sĩ"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            <!-- DANH SÁCH BUTTON CHỨC NĂNG (SOLID BLUE) -->
            <!-- Button 1 -->
            <Button
                    android:id="@+id/btn_view_schedule_appointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/primary_blue"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:drawablePadding="16dp"
                    android:drawableTint="@android:color/white"
                    android:elevation="4dp"
                    android:gravity="start|center_vertical"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:text="Quản lý Lịch làm việc"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            <!-- Button 2 -->
            <Button
                    android:id="@+id/btn_quick_patient_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/primary_blue"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="16dp"
                    android:drawableTint="@android:color/white"
                    android:elevation="4dp"
                    android:gravity="start|center_vertical"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:text="Tra cứu Hồ sơ bệnh nhân"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            <!-- Button 3 -->
            <Button
                    android:id="@+id/btn_exam_notes_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/primary_blue"
                    android:drawableStart="@android:drawable/ic_menu_edit"
                    android:drawablePadding="16dp"
                    android:drawableTint="@android:color/white"
                    android:elevation="4dp"
                    android:gravity="start|center_vertical"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:text="Ghi chú &amp; Kết quả khám"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            <!-- Button 4 -->
            <Button
                    android:id="@+id/btn_e_prescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/primary_blue"
                    android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                    android:drawablePadding="16dp"
                    android:drawableTint="@android:color/white"
                    android:elevation="4dp"
                    android:gravity="start|center_vertical"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:text="Kê đơn thuốc điện tử"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_staff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:elevation="8dp"
            app:itemIconTint="@color/primary_blue"
            app:itemTextColor="@color/primary_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_nav_menu_staff" />

</androidx.constraintlayout.widget.ConstraintLayout>