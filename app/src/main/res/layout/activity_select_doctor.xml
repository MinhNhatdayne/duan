<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9FC"
        tools:context=".activities_customer.SelectDoctorActivity">

    <!-- HEADER -->
    <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <ImageView
                    android:id="@+id/img_back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Quay lại" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Chọn bác sĩ"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />
        </LinearLayout>

        <TextView
                android:id="@+id/tv_selected_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:text="Dịch vụ: ..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3F51B5" />

    </LinearLayout>

    <!-- THANH TÌM KIẾM -->
    <!-- Đã sửa background thành màu trắng và thêm elevation để tránh lỗi thiếu file drawable -->
    <EditText
            android:id="@+id/et_search_doctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:hint="Tìm kiếm bác sĩ..."
            android:textSize="14sp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/header_layout"
            android:inputType="text"
            android:imeOptions="actionSearch" />

    <!-- DANH SÁCH BÁC SĨ (RECYCLER VIEW) -->
    <!-- ID: rv_list_doctors (Khớp 100% với Java) -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_list_doctors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/et_search_doctor"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION -->
    <!-- Nếu menu bị lỗi, App sẽ sập. Đảm bảo file res/menu/bottom_nav_menu.xml tồn tại -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_nav_menu"
            android:background="#FFFFFF"/>

</androidx.constraintlayout.widget.ConstraintLayout>